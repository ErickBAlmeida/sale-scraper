# === Bot de notificação (Bot API / @BotFather) ===
BOT_TOKEN=123456:ABC-DEF_sua_token_do_botfather

# === Userbot (MTProto / my.telegram.org -> API development tools) ===
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Seu id numérico no Telegram (dono/admin). Descubra com @userinfobot.
OWNER_ID=111111111

# Chave que criptografa as sessões das contas dos usuários (/login). OBRIGATÓRIA.
# Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde com cuidado: se perder ou trocar, todos os usuários precisam refazer /login.
SESSION_KEY=

# === Opcionais (têm defaults sensatos) ===
DB_PATH=data/sale_scraper.sqlite
SESSION_NAME=data/userbot
LOG_LEVEL=INFO
TIMEZONE=America/Sao_Paulo
MAX_KEYWORDS=10
# Janela (horas) em que o mesmo produto/preço repostado por outro canal não gera novo alerta (0 = desliga)
DEDUP_WINDOW_HOURS=24
# Contas conectadas ao mesmo tempo (cada uma = 1 conexão aberta) e canais por usuário
MAX_ACCOUNTS=20
MAX_SOURCES=20
# Canais novos em que cada conta pode entrar por hora (entrar em muitos seguidos = risco de spam)
JOINS_PER_HOUR=5
